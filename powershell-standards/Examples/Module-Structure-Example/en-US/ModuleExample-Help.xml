<?xml version="1.0" encoding="utf-8"?>
<helpItems xmlns:maml="http://schemas.microsoft.com/maml/2004/10" xmlns:command="http://schemas.microsoft.com/maml/dev/command/2004/10" xmlns:dev="http://schemas.microsoft.com/maml/dev/2004/10" schema="maml" xmlns="http://msh">
  <command:command>
    <command:details>
      <command:name>Get-ExampleData</command:name>
      <maml:description>
        <maml:para>Gets the status of one or more services.</maml:para>
      </maml:description>
      <command:verb>Get</command:verb>
      <command:noun>ExampleData</command:noun>
    </command:details>
    <maml:description>
      <maml:para>Emits one ExampleServiceResult object for each service name, in the order the names are received. A service that cannot be queried is reported as a non-terminating error, and the remaining names are still processed.

There is no real service behind this module. The statuses come from a fixed table that knows the services Billing, Identity, and Reporting. Every other name fails with the error ID ServiceNotFound.</maml:para>
    </maml:description>
    <command:syntax>
      <command:syntaxItem>
        <maml:name>Get-ExampleData</maml:name>
        <command:parameter required="true" variableLength="false" globbing="false" pipelineInput="false" position="0" aliases="none">
          <maml:name>ServiceName</maml:name>
          <maml:description />
          <command:parameterValue required="true" variableLength="false">string[]</command:parameterValue>
          <dev:type>
            <maml:name>System.String[]</maml:name>
          </dev:type>
        </command:parameter>
        <command:parameter required="false" variableLength="false" globbing="false" pipelineInput="false" position="1" aliases="none">
          <maml:name>Environment</maml:name>
          <maml:description />
          <command:parameterValue required="true" variableLength="false">string</command:parameterValue>
          <dev:type>
            <maml:name>System.String</maml:name>
          </dev:type>
        </command:parameter>
      </command:syntaxItem>
    </command:syntax>
    <command:parameters>
      <command:parameter required="false" variableLength="false" globbing="false" pipelineInput="false" position="1" aliases="none">
        <maml:name>Environment</maml:name>
        <maml:description>
          <maml:para>Environment to query, which is recorded on each result.</maml:para>
        </maml:description>
        <command:parameterValue required="true" variableLength="true">System.String</command:parameterValue>
        <dev:type>
          <maml:name>System.String</maml:name>
        </dev:type>
      </command:parameter>
      <command:parameter required="true" variableLength="false" globbing="false" pipelineInput="true (ByValue, ByPropertyName)" position="0" aliases="none">
        <maml:name>ServiceName</maml:name>
        <maml:description>
          <maml:para>One or more names of services to query.</maml:para>
        </maml:description>
        <command:parameterValue required="true" variableLength="true">System.String[]</command:parameterValue>
        <dev:type>
          <maml:name>System.String[]</maml:name>
        </dev:type>
      </command:parameter>
    </command:parameters>
    <command:inputTypes>
      <command:inputType>
        <dev:type>
          <maml:name>System.String[]</maml:name>
        </dev:type>
        <maml:description>
          <maml:para>You can pipe service names to this function, or objects that have a ServiceName property.</maml:para>
        </maml:description>
      </command:inputType>
    </command:inputTypes>
    <command:returnValues>
      <command:returnValue>
        <dev:type>
          <maml:name>ExampleServiceResult</maml:name>
        </dev:type>
        <maml:description>
          <maml:para>One object for each service that was queried, with ServiceName, Environment, Status, and CheckedAt properties.</maml:para>
        </maml:description>
      </command:returnValue>
    </command:returnValues>
    <maml:alertSet>
      <maml:alert>
        <maml:para>The error for a service that cannot be queried is non-terminating. To end the command at the first such service, pass -ErrorAction Stop.</maml:para>
      </maml:alert>
    </maml:alertSet>
    <command:examples>
      <command:example>
        <maml:title>--------- Example 1: Get the status of one service ---------</maml:title>
        <maml:introduction>
          <maml:para>```powershell
Get-ExampleData -ServiceName 'Billing'
```</maml:para>
          <maml:para>&#x80;</maml:para>
          <maml:para>Gets the status of the Billing service in the Development environment.</maml:para>
        </maml:introduction>
        <dev:code />
        <dev:remarks />
      </command:example>
      <command:example>
        <maml:title>--------- Example 2: Take the service names from the pipeline ---------</maml:title>
        <maml:introduction>
          <maml:para>```powershell
'Billing', 'Identity', 'Reporting' | Get-ExampleData -Environment 'Test'
```</maml:para>
          <maml:para>&#x80;</maml:para>
          <maml:para>Gets the status of three services in the Test environment, taking the names from the pipeline.</maml:para>
        </maml:introduction>
        <dev:code />
        <dev:remarks />
      </command:example>
      <command:example>
        <maml:title>--------- Example 3: Continue after a service that cannot be queried ---------</maml:title>
        <maml:introduction>
          <maml:para>```powershell
Get-ExampleData -ServiceName 'Billing', 'Missing', 'Reporting'
```</maml:para>
          <maml:para>&#x80;</maml:para>
          <maml:para>Gets the status of Billing and Reporting, and writes a non-terminating error for Missing.</maml:para>
        </maml:introduction>
        <dev:code />
        <dev:remarks />
      </command:example>
    </command:examples>
